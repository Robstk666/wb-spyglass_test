# Переименуй этот файл в .env и заполни значения

# Токен бота — получить у @BotFather в Telegram
TG_TOKEN=1234567890:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Токен Wildberries (xwb-token из cookies wildberries.ru)
# Как получить:
#   1. Открой wildberries.ru в Chrome
#   2. F12 → Application → Cookies → wildberries.ru
#   3. Найди строку xwb-token, скопируй Value
# Если не задан — бот попробует получить сам через Chrome (нужен seleniumbase)
WB_TOKEN=
